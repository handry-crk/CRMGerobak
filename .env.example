# Salin ke .env lalu isi. Semua variabel dibaca backend (backend/app/config.py).
APP_NAME=Stamp Bojot
MONGO_URL=mongodb://localhost:27017
MONGO_DB=stamp_bojot
# URL publik frontend; dipakai di QR stiker (/s/{token}). Produksi: https://stamp.cimolbojotaa.com
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=ganti-dengan-rahasia-panjang
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_PIN=1234
# Kunci untuk /api/public-metrics (Service Excellence Dashboard, Daily Tracker)
METRICS_API_KEY=ganti-api-key-metrics
ADMIN_EMAIL=
# SMTP opsional untuk digest harian & rekap mingguan (kosong = hanya dicatat di log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Stamp Bojot <noreply@cimolbojotaa.com>
BACKUP_DIR=backups
ENABLE_SCHEDULER=true
# true = database in-memory (tanpa MongoDB) untuk coba cepat; data hilang saat restart
USE_MOCK_DB=false
CORS_ORIGINS=*
